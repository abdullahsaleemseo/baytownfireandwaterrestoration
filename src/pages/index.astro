---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CallButton from '../components/CallButton.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/Faq.astro';
import { SITE, DISCLOSURE, GUIDES, phone } from '../lib/site';
import { IMG } from '../data/images';

const fire = phone('fire');

const faqs = [
  {
    q: 'Do you do the restoration work yourselves?',
    a: 'No. Baytown Fire and Water Restoration is a referral line. When you call, you are routed to an independent local restoration company, and that company inspects the damage, gives you an estimate and does the work if you hire them.',
  },
  {
    q: 'What should I do right now if there is water on my floor?',
    a: 'Shut off the water at the fixture or the main valve, and keep away from wet outlets and cords. Then take photos, move what you can to a dry room, and call a restoration company and your insurer. The EPA advises drying wet materials within 24 to 48 hours to prevent mold growth.',
  },
  {
    q: 'How fast will a company get to my house?',
    a: 'We cannot promise a time. We do not dispatch crews, and arrival depends on the company you reach and how busy the area is. Ask for a realistic arrival time on the call, and expect longer waits after a hurricane, flood or freeze.',
  },
  {
    q: 'Does homeowners insurance pay for water damage in Texas?',
    a: 'Often, when the damage is sudden and accidental. The Texas Department of Insurance says most home policies cover losses like a burst pipe or broken washer hose, and usually do not cover gradual leaks or flooding, which needs a separate flood policy. Your own policy decides.',
  },
  {
    q: 'Why does mold show up so quickly in Baytown homes?',
    a: 'Because the air here is warm and humid for most of the year, so wet drywall, carpet and wood stay damp unless they are dried mechanically. Mold needs only moisture, a food source and mild temperatures, and a wet Gulf Coast house has all three.',
  },
  {
    q: 'Is there a separate number for fire damage?',
    a: `Yes. Fire and smoke damage calls go to ${fire.display}, and water damage calls go to the main number at the top of the page. Both connect you with independent restoration companies serving Baytown.`,
  },
];

const heroOpt = await getImage({ src: IMG.hero.src, width: 900, format: 'webp', quality: 62 });
const heroSm = await getImage({ src: IMG.hero.src, width: 560, format: 'webp', quality: 60 });
const heroSrcset = `${heroSm.src} 560w, ${heroOpt.src} 900w`;
const heroSizes = '(max-width: 980px) calc(100vw - 64px), 540px';
---
<Base
  title="Baytown Fire and Water Restoration | Water Damage Help"
  description="Fire and water damage restoration help in Baytown, TX. One call connects you with an independent local restoration company. Clear, honest guides."
  faqs={faqs}
  preloadImage={{ src: heroOpt.src, srcset: heroSrcset, sizes: heroSizes }}
>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__text">
        <p class="eyebrow">Baytown, TX / Local referral line</p>
        <h1>Fire and Water Damage <em>Restoration</em> in Baytown, TX</h1>
        <p class="hero__tags">Water &middot; Fire &middot; Smoke &middot; Storm damage</p>
        <p class="hero__lead">
          A burst pipe, a flooded room or a kitchen fire is hard enough without guessing who to call. Baytown Fire and Water Restoration puts you on the phone with a local company that handles water damage restoration in Baytown, and gives you plain guidance while you wait.
        </p>
        <div class="btn-row">
          <CallButton variant="btn--lg" label="Call {phone}" location="hero" />
          <a class="btn btn--ghost btn--lg" href="#services">See services</a>
        </div>
        <p class="hero__note">{DISCLOSURE}</p>
        <ul class="hero__bullets">
          <li><strong>Free</strong> to call</li>
          <li><strong>Independent</strong> local companies</li>
          <li><strong>No obligation</strong> to hire</li>
        </ul>
      </div>
      <figure class="frame">
        <img
          src={heroOpt.src}
          srcset={heroSrcset}
          sizes={heroSizes}
          width={heroOpt.attributes.width}
          height={heroOpt.attributes.height}
          alt={IMG.hero.alt}
          fetchpriority="high"
          decoding="async"
        />
        <figcaption><span><b>Illustration</b> {IMG.hero.short}</span><span>{IMG.hero.credit}</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- 4. FACTS BAND (true, checkable facts only) -->
  <section class="trust" aria-label="Key facts">
    <div class="wrap">
      <div class="trust__card">
        <div class="trust__top">
          <div class="trust__badge"><Icon name="users" /></div>
          <div>
            <h2>A referral line, not a contractor</h2>
            <p>We do not send our own crews. We connect you with an independent restoration company, and you decide whether to hire them.</p>
          </div>
        </div>
        <ul class="trust__items">
          <li><Icon name="clock" /><div><strong>{SITE.phoneHours}</strong><span>Phone hours</span></div></li>
          <li><Icon name="phone" /><div><strong>Free phone consultation</strong><span>We never charge callers</span></div></li>
          <li><Icon name="pin" /><div><strong>3 Baytown ZIP codes</strong><span>{SITE.zips.join(', ')}</span></div></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. SERVICES -->
  <section class="section bg-light" id="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Restoration help in <em>Baytown</em></h2>
        <p>From hurricane-season flooding to slab leaks and kitchen fires, these are the problems Baytown homes run into most. <a href="#all-services">View all services and guides</a>.</p>
      </div>

      <article class="feature">
        <div class="feature__img">
          <span class="tag-flag">Most common</span>
          <Image src={IMG.water.src} alt={IMG.water.alt} width={760} widths={[480, 760]} sizes="(max-width: 980px) 100vw, 640px" quality={60} loading="lazy" />
        </div>
        <div class="feature__body">
          <h3>Water <em>Damage Restoration</em></h3>
          <p>Extraction, structural drying and dehumidifying after leaks and overflows. Learn what the process involves and how long drying takes in Gulf Coast humidity.</p>
          <ul class="chips">
            <li>Extraction</li><li>Drying</li><li>Ceiling leaks</li><li>Slab leaks</li>
          </ul>
          <p style="margin:18px 0 0"><a class="text-link" href="/water-damage-restoration-baytown-tx/">Learn more about water damage <Icon name="arrow" /></a></p>
        </div>
      </article>

      <ul class="cards">
        <li class="card">
          <Image src={IMG.fire.src} alt={IMG.fire.alt} width={640} widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" quality={60} loading="lazy" />
          <div class="card__body">
            <h3>Fire and Smoke Damage</h3>
            <p>Soot, smoke odor and the water left behind by firefighting. What to leave alone, and what cleanup involves.</p>
            <a class="text-link" href="/fire-smoke-damage-restoration-baytown-tx/">Learn more about fire damage <Icon name="arrow" /></a>
          </div>
        </li>
        <li class="card">
          <Image src={IMG.pipe.src} alt={IMG.pipe.alt} width={640} widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" quality={60} loading="lazy" />
          <div class="card__body">
            <h3>Burst Pipes and Flooding</h3>
            <p>Frozen pipes, failed supply lines, water heaters and slab leaks. Start with the shutoff valve, then follow these steps.</p>
            <a class="text-link" href="/burst-pipe-water-damage-baytown/">Learn more about burst pipes <Icon name="arrow" /></a>
          </div>
        </li>
        <li class="card card--dark">
          <div class="card__body">
            <h3>Not sure what you need?</h3>
            <p>Describe what happened on the phone. The restoration company you are connected with can tell you what the next step should be.</p>
            <CallButton label="Call {phone}" location="services-card" />
            <a class="text-link" href="/how-it-works/">Or see how it works <Icon name="arrow" /></a>
          </div>
        </li>
      </ul>

      <div id="all-services" style="margin-top:34px">
        <h3>More services and guides</h3>
        <ul class="dotlist">
          <li><a href="/flood-storm-water-cleanup-baytown/">Flood and storm water cleanup</a></li>
          <li><a href="/mold-after-water-damage-baytown/">Mold after water damage</a></li>
          {GUIDES.map((g) => <li><a href={g.href}>{g.label === 'Insurance Claim Tips' ? 'Water damage insurance claim tips' : 'Choosing a restoration company'}</a></li>)}
          <li><a href="/service-area/">Baytown service area</a></li>
          <li><a href="/faq/">Frequently asked questions</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2 + 5. ABOUT and WHY CHOOSE US -->
  <section class="section">
    <div class="wrap why">
      <div>
        <p class="eyebrow">About us</p>
        <h2>An honest <em>local help line</em></h2>
        <figure>
          <Image src={IMG.about.src} alt={IMG.about.alt} width={700} widths={[420, 700]} sizes="(max-width: 980px) 100vw, 440px" quality={60} loading="lazy" />
          <figcaption>{IMG.about.caption}</figcaption>
        </figure>
        <p class="why__quote">
          We built this site because too many "local" restoration listings are not what they claim to be. Ours says what it is: a phone line to independent companies, with guides we check against official sources.
        </p>
        <p style="margin-top:18px"><a class="text-link" href="/about/">Learn more about us <Icon name="arrow" /></a></p>
      </div>
      <div>
        <p class="eyebrow">Why homeowners use this line</p>
        <ol class="numlist">
          <li>
            <h3>We tell you who you are calling</h3>
            <p>No invented office address, crew photos or reviews. You reach an independent company, and we say so on every page.</p>
          </li>
          <li>
            <h3>Baytown only</h3>
            <p>Three ZIP codes, one city. Calls go to companies that work here, in homes built on Gulf Coast clay and in Gulf Coast humidity.</p>
          </li>
          <li>
            <h3>Guidance you can check</h3>
            <p>Safety, insurance and mold licensing information is drawn from the EPA, the National Weather Service and Texas state agencies, with links.</p>
          </li>
          <li>
            <h3>You stay in control</h3>
            <p>Calling costs nothing and commits you to nothing. We show you how to verify insurance and licenses before you hire.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 6. IMAGE GRID -->
  <section class="section bg-light">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Signs you need restoration</p>
        <h2>What water and fire damage <em>look like</em></h2>
        <p>Illustrative photos from public sources. They are not pictures of our work, because we do not do the work.</p>
      </div>
      <ul class="gallery">
        {IMG.grid.map((g) => (
          <li>
            <figure>
              <Image src={g.src} alt={g.alt} width={600} widths={[360, 600]} sizes="(max-width: 640px) 100vw, 380px" quality={58} loading="lazy" />
              <figcaption><b>{g.title}</b>{g.caption}<small>Photo: {g.credit}</small></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. FIRST STEPS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Safety first</p>
        <h2>First steps after <em>water or fire damage</em></h2>
        <p>Do these before anything else. If anyone is in danger, call 911.</p>
      </div>
      <ul class="checklist">
        <li>
          <h3><Icon name="drop" />Stop the water, if it is safe</h3>
          <p>Close the valve at the fixture or the main shutoff at the house or meter. The Texas Department of Insurance lists stopping the flow as the first step in limiting damage.</p>
        </li>
        <li>
          <h3><Icon name="bolt" />Keep clear of wet electricity</h3>
          <p>If water is near outlets, cords or the breaker panel, stay out of the area. The National Weather Service says to make sure the electrical system is off before entering a flood-damaged building.</p>
        </li>
        <li>
          <h3><Icon name="flame" />Stay out after a fire until cleared</h3>
          <p>The American Red Cross advises staying out of fire-damaged homes until local fire authorities say it is safe to re-enter. Floors and roofs can be weaker than they look.</p>
        </li>
        <li>
          <h3><Icon name="camera" />Take photos for insurance</h3>
          <p>Photograph and video the damage before moving or discarding anything, and keep damaged items until your adjuster has seen them. Save receipts for temporary repairs.</p>
        </li>
      </ul>
      <p class="source-note">
        Sources: <a href="https://www.tdi.texas.gov/tips/when-are-water-damage-and-mold-covered-by-insurance.html" rel="noopener">Texas Department of Insurance</a>, <a href="https://www.weather.gov/safety/flood-after" rel="noopener">National Weather Service</a>, <a href="https://www.redcross.org/get-help/how-to-prepare-for-emergencies/types-of-emergencies/fire/home-fire-recovery.html" rel="noopener">American Red Cross</a>. Sewage, floodwater and mold call for professionals: see our <a href="/flood-storm-water-cleanup-baytown/">flood cleanup</a> and <a href="/mold-after-water-damage-baytown/">mold</a> pages.
      </p>
    </div>
  </section>

  <!-- 8 + 9. HOW IT WORKS and FIRE SECTION -->
  <section class="section bg-dark">
    <div class="wrap dark-split">
      <div class="panel panel--fire">
        <p class="panel__label"><Icon name="flame" />Fire damage line</p>
        <h2>Fire or <em>smoke damage?</em></h2>
        <p>
          Soot keeps damaging surfaces after the flames are out, and water from the hoses needs drying quickly. Once the fire department has cleared your home, the fire damage line connects you with an independent company that handles fire and smoke cleanup in Baytown.
        </p>
        <div class="btn-row">
          <CallButton offer="fire" label="Call {phone}" location="home-fire" />
        </div>
        <p style="margin:18px 0 0"><a class="text-link" href="/fire-smoke-damage-restoration-baytown-tx/">Read the fire and smoke guide <Icon name="arrow" /></a></p>
      </div>
      <div>
        <p class="eyebrow">How it works</p>
        <h2>What happens <em>when you call</em></h2>
        <ol class="steps">
          <li>
            <h3>Call</h3>
            <p>Dial the number for water damage or fire damage. There is no charge from us.</p>
          </li>
          <li>
            <h3>Get connected with a local restoration company</h3>
            <p>Your call is routed to an available independent company that serves Baytown. You speak with them directly.</p>
          </li>
          <li>
            <h3>Get an inspection and estimate</h3>
            <p>The company arranges a visit and gives you its own estimate. Check its insurance and licenses, then decide.</p>
          </li>
        </ol>
        <p><a class="text-link" href="/how-it-works/">Full details on how it works <Icon name="arrow" /></a></p>
      </div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="section bg-light">
    <div class="wrap">
      <div class="section-head" style="max-width:880px;margin-left:auto;margin-right:auto">
        <p class="eyebrow">Common questions</p>
        <h2>Baytown restoration <em>FAQ</em></h2>
      </div>
      <FaqList items={faqs} />
      <p style="text-align:center;margin:26px 0 0"><a class="text-link" href="/contact/">Ask us something else <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- Reviews: intentionally absent until real reviews exist. See src/components/Reviews.astro -->

  <!-- 11. CTA -->
  <CtaBand heading="Ready when you <em>need help</em>" text="One call connects you with an independent restoration company serving Baytown." label="Call {phone}" />
</Base>
