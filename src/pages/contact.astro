---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import CallButton from '../components/CallButton.astro';
import { SITE, phone } from '../lib/site';
const line = phone('water');
---
<Page
  title="Contact | Baytown Fire and Water Restoration"
  description={`Call the Baytown, TX help line at ${SITE.phoneWater} for water damage, fire and smoke damage, mold or biohazard cleanup. Answered 24/7.`}
  h1="Contact Us"
  h1Html="Contact <em>Us</em>"
  eyebrow="Call first"
  sub="For water damage, fire and smoke damage, mold or biohazard cleanup, calling is the fastest way to get help."
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
>
  <section class="section">
    <div class="wrap contact-grid">
      <div>
        <div class="call-panel">
          <p class="call-panel__label">Baytown, TX help line</p>
          <a class="call-panel__number" href={line.tel} data-offer="water" data-call-location="contact-number">{line.display}</a>
          <p class="call-panel__covers">One number for water damage, fire and smoke damage, mold and biohazard cleanup.</p>
          <CallButton variant="btn--lg" label="Tap to call now" location="contact" />
          <p class="call-panel__hours"><Icon name="clock" /><span>Phone hours: <strong>24/7</strong>, including weekends and holidays</span></p>
        </div>
        <p class="contact-note">Calls are answered by independent, licensed local restoration companies. {SITE.brandName} is a referral service and does not perform the work. <a href="/how-it-works/">See how it works</a>.</p>
        <p class="source-note">Fire still burning, gas smell, or someone hurt? Call 911 first.</p>
      </div>

      <div>
        <div class="contact-card contact-card--list">
          <Icon name="doc" />
          <div>
            <h2>What to have ready when you call</h2>
            <ul>
              <li>Your address in Baytown</li>
              <li>What happened and when it started</li>
              <li>Whether water is still coming in, and whether you have shut it off</li>
              <li>Photos for insurance, if you can take them safely</li>
            </ul>
          </div>
        </div>
        <div class="contact-card">
          <Icon name="mail" />
          <div>
            <h2>Email for non-urgent questions</h2>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <p>Questions about this website, corrections or feedback. For damage in your home, please call.</p>
          </div>
        </div>
        <div class="contact-card">
          <Icon name="pin" />
          <div>
            <h2>Service area</h2>
            <p>Baytown, TX, ZIP codes {SITE.zips.join(', ')}. See the <a href="/service-area/">Baytown service area map</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Page>
