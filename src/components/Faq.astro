---
import type { Faq } from '../lib/schema';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary><h3>{f.q}</h3></summary>
      <div class="faq__a"><p set:html={f.a} /></div>
    </details>
  ))}
</div>
