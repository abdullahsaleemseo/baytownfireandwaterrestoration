---
import { SITE } from '../lib/site';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a class:list={['logo', { 'logo--light': light }]} href="/" aria-label={`${SITE.brandName} home`}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect width="48" height="48" fill="#0074D4"/>
    <path fill="#fff" d="M17 8s1.2 4.6-2.4 8.4C11.6 19.7 8 22.4 8 28a9 9 0 0 0 9 9c1.3 0 2.5-.3 3.6-.8A12.4 12.4 0 0 1 18.500 29c0-4.600 2.900-9.400 5.500-13-1.500-3.300-4-6.200-7-8z" opacity=".85"/>
    <path fill="#fff" d="M31 13s-9 10-9 16.500a9 9 0 0 0 18 0C40 23 31 13 31 13zm-1.500 22a5.500 5.500 0 0 1-4.100-5.300h2.400a3.200 3.200 0 0 0 1.700 2.800z"/>
  </svg>
  <span class="logo__text">Baytown <span>Fire and Water Restoration</span></span>
</a>
