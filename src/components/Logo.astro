---
// Brand wordmark. Images are generated by scripts/make-brand-assets.mjs.
import { SITE } from '../lib/site';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a class:list={['logo', { 'logo--light': light }]} href="/" aria-label={`${SITE.brandName} home`}>
  <img src={light ? '/logo-footer.webp' : '/logo-header.webp'} alt={SITE.brandName} width="570" height="168" decoding="async" />
</a>
