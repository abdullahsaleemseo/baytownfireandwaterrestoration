---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, SERVICES, GUIDES, QUICK_LINKS, DISCLOSURE, HOURS_KNOWN, phone, type Offer } from '../lib/site';
interface Props { offer?: Offer }
const { offer = 'water' } = Astro.props;
const p = phone(offer);
const year = new Date().getFullYear();
const years = String(year) === SITE.launchYear ? SITE.launchYear : `${SITE.launchYear} to ${year}`;
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <Logo light />
      <p class="footer-note">{DISCLOSURE} We do not perform restoration work ourselves.</p>
    </div>
    <nav aria-label="Quick links">
      <h2>Quick links</h2>
      <ul>
        {QUICK_LINKS.map((l) => <li><a href={l.href}><Icon name="arrow" />{l.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Services and guides">
      <h2>Services and guides</h2>
      <ul>
        {[...SERVICES, ...GUIDES].map((l) => <li><a href={l.href}><Icon name="arrow" />{l.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={p.tel} data-offer={p.offer} data-call-location="footer"><Icon name="phone" />{p.display}</a></li>
        <li><a href={`mailto:${SITE.email}`}><Icon name="mail" />{SITE.email}</a></li>
      </ul>
      <p class="footer-note">{HOURS_KNOWN && <>Phone hours: {SITE.phoneHours}<br /></>}Service area: Baytown, TX ({SITE.zips.join(', ')})</p>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="wrap">
      <p>Copyright &copy; {years} {SITE.brandName}</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/disclaimer/">Disclaimer</a></li>
      </ul>
    </div>
  </div>
</footer>
